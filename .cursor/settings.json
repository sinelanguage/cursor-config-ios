{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [100, 120],
  "editor.wordWrap": "on",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/DerivedData": true,
    "**/.build": true,
    "**/.swiftpm": true,
    "**/xcuserdata": true,
    "**/xcshareddata": false
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/DerivedData/**": true,
    "**/.build/**": true,
    "**/.swiftpm/**": true
  },
  "search.exclude": {
    "**/DerivedData": true,
    "**/.build": true,
    "**/.swiftpm": true,
    "**/xcuserdata": true,
    "**/*.xcworkspace/xcshareddata": true
  }
}
