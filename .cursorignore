# Cursor IDE Ignore File
# Controls which files and directories Cursor indexes for AI context
# Uses .gitignore syntax

# Xcode build outputs
DerivedData/
build/
*.xcresult
*.xcarchive
*.dSYM
*.ipa
*.app
*.appex
*.symbols

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Xcode user state
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Fastlane outputs
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/
.temp/

# Secrets and certificates
*.p12
*.mobileprovision
*.cer
*.pem
*.key
*.cert
