default_platform(:ios)

platform :ios do
  desc "Run SwiftLint"
  lane :lint do
    sh "swiftlint lint"
  end

  desc "Run unit tests"
  lane :tests do
    scan(
      scheme: ENV["SCHEME"] || "YourApp",
      clean: true
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build_app(
      scheme: ENV["SCHEME"] || "YourApp",
      export_method: "app-store"
    )
    upload_to_testflight
  end
end
